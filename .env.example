# Copy this file to .env.local (in this folder) and fill in your own values.
# .env.local is git-ignored. Never commit real keys.
#
# Everything below starts with NEXT_PUBLIC_, which means it is compiled into the website and visible to
# anyone who opens it. Use only the Supabase *anon / publishable* key and free-tier AI keys here.
# NEVER put the Supabase service-role / secret key or the database password in this project.

# --- Supabase (required): Project Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- AI stylist providers (optional; any one is enough) ---
# Used by `npm run dev` on your own machine only. Production builds leave them out on purpose; in a deployed
# site each visitor pastes their own key under Settings, which is kept in that browser only.
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GROQ_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=
